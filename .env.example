APP_ENV=development
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=10s

POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=fraud

# Used when running the app outside Docker (go run). Docker Compose overrides these for the app container.
DATABASE_URL=postgres://fraud:fraud@localhost:5432/fraud?sslmode=disable
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:29092

# transactions.received is created by cmd/api at startup with these settings.
# Partitions are the upper bound on useful worker replicas. Events are keyed
# by account_id, so changing the count of an existing topic remaps accounts
# (drain the lag first, see ADR 0012). Existing topics are never resized.
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1

# POST /transactions: synchronous publish timeout (503 when exceeded) and
# global rate limit (429 when exceeded). INGEST_RATE_LIMIT_RPS=0 disables it.
INGEST_PUBLISH_TIMEOUT=5s
INGEST_RATE_LIMIT_RPS=0
INGEST_RATE_LIMIT_BURST=100

# Ingestion API base URL targeted by cmd/simulator (--target=http).
SIMULATOR_TARGET_URL=http://localhost:8080

# cmd/worker: Kafka consumer group of the analysis consumer.
WORKER_CONSUMER_GROUP=analysis

# Analysis (ADR 0010): sum of fired rule scores >= BLOCK -> block, >= REVIEW -> review.
ANALYSIS_PROCESS_TIMEOUT=10s
ANALYSIS_REVIEW_THRESHOLD=50
ANALYSIS_BLOCK_THRESHOLD=80
# Redis state (ADR 0009): card history window, amounts per account median, device/country memory.
ANALYSIS_HISTORY_RETENTION=24h
ANALYSIS_BASELINE_SIZE=50
ANALYSIS_PROFILE_TTL=2160h
# velocity: more than MAX purchases on one card within WINDOW.
ANALYSIS_VELOCITY_WINDOW=3m
ANALYSIS_VELOCITY_MAX=6
ANALYSIS_VELOCITY_SCORE=80
# card_testing: MIN_COUNT ecommerce charges <= SMALL_AMOUNT (minor units) within WINDOW;
# CASHOUT_SCORE is added when the current charge is larger.
ANALYSIS_CARD_TESTING_WINDOW=10m
ANALYSIS_CARD_TESTING_SMALL_AMOUNT=1000
ANALYSIS_CARD_TESTING_MIN_COUNT=4
ANALYSIS_CARD_TESTING_SCORE=60
ANALYSIS_CARD_TESTING_CASHOUT_SCORE=30
# impossible_travel: implied speed from the card's previous location above MAX_KMH, distance >= MIN_KM.
ANALYSIS_TRAVEL_MAX_KMH=900
ANALYSIS_TRAVEL_MIN_KM=500
ANALYSIS_TRAVEL_SCORE=80
# amount_outlier: amount >= RATIO x account median, with at least MIN_SAMPLES past amounts.
ANALYSIS_OUTLIER_RATIO=10
ANALYSIS_OUTLIER_MIN_SAMPLES=5
ANALYSIS_OUTLIER_SCORE=60
# new_device_foreign: each signal adds its score.
ANALYSIS_RISKY_MCCS=7995,6051
ANALYSIS_NEW_DEVICE_SCORE=20
ANALYSIS_NEW_COUNTRY_SCORE=25
ANALYSIS_RISKY_MCC_SCORE=25
