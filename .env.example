APP_ENV=development
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=10s

POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=fraud

# Used when running the app outside Docker (go run). Docker Compose overrides these for the app container.
DATABASE_URL=postgres://fraud:fraud@localhost:5432/fraud?sslmode=disable
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:29092
